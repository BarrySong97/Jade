{
  "installCommand": "pnpm install",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
