---
import { Image } from "astro:assets";
import profilePortrait from "@/assets/info/profile-portrait.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Site OG Preview</title>
  </head>
  <body
    style="margin: 0; min-height: 100vh; display: grid; place-items: center; overflow: auto; background: #ededed;"
  >
    <main
      style="box-sizing: border-box; width: 1200px; height: 630px; flex: 0 0 auto; display: grid; grid-template-columns: 430px 430px; align-items: center; justify-content: space-between; overflow: hidden; padding: 0 48px; background: #ffffff; color: #181818;"
    >
      <Image
        src={profilePortrait}
        alt="Barry Song 的手绘肖像"
        width={860}
        quality={95}
        style="display: block; width: 430px; height: auto;"
      />

      <div style="min-width: 0; transform: translateY(-4px);">
        <h1
          style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 68px; font-weight: 700; line-height: 0.95; letter-spacing: -3.4px; color: #171717;"
        >
          Barry Song
        </h1>
        <p
          style="margin: 28px 0 0; font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 23px; font-weight: 400; line-height: 1; letter-spacing: 0.8px; color: #777777;"
        >
          Explore the World
        </p>
      </div>
    </main>
  </body>
</html>
