---
import ProductsLayout from "@/layouts/ProductsLayout.astro";
import WorkDetail from "@/components/showcase/work-detail";
import { WORKS, getWorkBySlug } from "@/components/showcase/works-data";
import "@/styles/showcase.css";

export function getStaticPaths() {
  return WORKS.map((w) => ({ params: { slug: w.slug } }));
}

const work = getWorkBySlug(Astro.params.slug!);
---

<ProductsLayout title={work!.t}>
  <WorkDetail client:load work={work!} />
</ProductsLayout>
