---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PROFILE } from "@/lib/site";
import ProfileIntro from "@/components/home/profile-intro.astro";
import PostArchive from "@/components/home/post-archive.astro";
---

<BaseLayout title={PROFILE.name} description={PROFILE.bio}>
  <div class="mx-auto max-w-[728px] px-6 min-[728px]:max-w-[680px] min-[728px]:px-0">
    <ProfileIntro />
    <PostArchive />
  </div>
</BaseLayout>
