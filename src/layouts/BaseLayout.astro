---
/**
 * @purpose 博客页面基础布局
 * @role Header、内容、Footer 与可选页尾插槽
 * @deps HeadSEO、ClientRouter、Header、Footer
 * @gotcha page-end 只提供插槽；首页自行传入草甸，其他页面不会挂载或加载它
 */
import { ClientRouter } from "astro:transitions";
import HeadSEO from "@/components/HeadSEO.astro";
import Header from "@/components/layout/header";
import Footer from "@/components/layout/footer";
import CubeTransition from "@/components/showcase/cube-transition.astro";

const { title, description, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} />
    <ClientRouter />
    <CubeTransition />
  </head>
  <body>
    <div class="flex min-h-screen flex-col bg-background text-foreground">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
      <slot name="page-end" />
    </div>
  </body>
</html>
